generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Story {
  id            String   @id @default(cuid())
  cell          String?  @unique
  wisher        String
  prose         String

  fullStory     String?
  parsed        Json
  capabilityId  String
  conditionHash String
  storyHash     String
  createdAt     DateTime @default(now())

  featured      Boolean  @default(false)
  curatorNote   String?

  @@index([capabilityId])
  @@index([featured])
}

model RunEntry {
  seq          Int      @id
  ts           DateTime
  trigger      String
  kind         String
  capabilityId String?
  cell         String?
  model        String
  provider     String
  pass         Boolean?
  score        Float?
  detail       Json
  inputTokens  Int
  outputTokens Int
  hash         String   @unique
  signature    String
  signer       String

  @@index([capabilityId, model])
  @@index([kind])
}

model Watch {
  id         String   @id @default(cuid())
  subscriber String
  kind       String
  target     String
  createdAt  DateTime @default(now())

  @@unique([subscriber, kind, target])
  @@index([kind, target])
}

model Notification {
  id           String   @id @default(cuid())
  dedupeKey    String   @unique
  subscriber   String
  kind         String
  title        String
  body         String
  cell         String?
  capabilityId String?
  triggerSeq   Int
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([subscriber, read])
  @@index([subscriber, createdAt])
}

model PushSubscription {
  id         String   @id @default(cuid())
  subscriber String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([subscriber])
}

/// Every transaction the protocol has sent, recorded when we send it.
///
/// The alternative — replaying `eth_getLogs` on page load — cannot work against
/// a public endpoint: Base Sepolia caps a range at 2000 blocks, so history older
/// than about an hour is simply unreachable, and a rejected query is
/// indistinguishable from a contract that has never emitted anything. Writing the
/// row at the moment we broadcast is both complete and free to read back.
///
/// This records what *happened*. Current state — a votive's phase, an operator's
/// standing, what is left of an allowance — is never cached here; it is read from
/// the contracts' own view functions, because a cached balance is a wrong balance
/// as soon as anybody transacts without us.
model ChainTx {
  id        String   @id @default(cuid())
  /// Which integration this demonstrates: votive, world, hedera, aqua.
  track     String
  /// CAIP-ish chain key, e.g. "base-sepolia" or "hedera-testnet".
  chain     String
  txHash    String
  /// One line a judge can read without knowing the codebase.
  what      String
  detail    String
  /// The contract this touched, when there is a single obvious one.
  contract  String?
  /// The votive, agent wallet, or resource this concerned.
  subject   String?
  blockNumber BigInt?
  createdAt DateTime @default(now())

  @@unique([txHash, what])
  @@index([track])
  @@index([chain])
  @@index([createdAt])
}
