# Postgres (Prisma)
DATABASE_URL="postgresql://user@localhost:5432/votive"

# Chain (read surfaces)
NEXT_PUBLIC_WELL_CHAIN_ID=84532
NEXT_PUBLIC_WELL_RPC_URL=https://base-sepolia-rpc.publicnode.com
NEXT_PUBLIC_WELL_FACTORY=0x...
NEXT_PUBLIC_WELL_REGISTRY=0x...
NEXT_PUBLIC_WELL_POSITION_REGISTRY=0x...
NEXT_PUBLIC_WELL_TOKENS=0x...:USDC:6

# World: human backing, standing, commons
NEXT_PUBLIC_WELL_HUMAN_REGISTRY=0x...
NEXT_PUBLIC_WELL_STANDING_LEDGER=0x...
NEXT_PUBLIC_WELL_STANDING_ADAPTER=0x...
NEXT_PUBLIC_WELL_COMMONS_POOL=0x...
NEXT_PUBLIC_WELL_HUMAN_GATE=0x...
NEXT_PUBLIC_WELL_RESOURCE_REGISTRY=0x...

# Bounty rails (agentic payments)
NEXT_PUBLIC_WELL_BOUNTY_RAIL=0x...        # Base Sepolia; the solutions flow settles here
NEXT_PUBLIC_HEDERA_BOUNTY_RAIL=0x...
NEXT_PUBLIC_HEDERA_CHAIN_ID=296
NEXT_PUBLIC_HEDERA_RPC_URL=https://testnet.hashio.io/api

# Agent platform
WELL_AGENT_KEY_PEPPER=                    # HMAC pepper for agent keys; REQUIRED in production or key issuance is disabled
WELL_ATTESTOR_PK=0x...                    # attestation registry attestor; drives solution settlement + World mirroring
WELL_REVIEWER_PK=0x...                    # StandingLedger reviewer; drives conduct reports (may equal the attestor on testnet)
WELL_DEMO_WINDOW=                         # optional, seconds; shortens the solution objection window (default 3 days)
WELL_WORLD_ENABLED=                       # set to 1 to verify agents against AgentBook on World Chain
WELL_AGENTBOOK_ADDRESS=                   # optional override; a default is compiled in
WELL_WORLD_CHAIN_RPC_URL=                 # optional override; a default is compiled in

# Agent registry / eval data (server)
WELL_MODELS_FILE=                         # path to models.json; the agent builder validates baseModel against it
WELL_DATA_DIR=                            # where stores + the signed run log live
WELL_CURATOR_TOKEN=                       # gates strategy-agent approval + curation endpoints
WELL_MOCK_LLM=                            # set to 1 for deterministic evals with no provider

# Web push (VAPID) — optional
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The origin this deployment answers on, baked into every skill file served at
# /skills/* so an agent knows where to POST back.
#
# Leave it UNSET in normal operation: the origin is derived per-request from
# x-forwarded-proto / x-forwarded-host / host, which is correct by construction on
# localhost, a preview build and production alike. Set it only when a proxy
# rewrites Host to something an agent cannot reach back on — then this wins.
#
#   WELL_BASE_URL=https://votive.example
WELL_BASE_URL=

# ---- World: AgentBook (real lookups, not mock) -----------------------------
# An agent wallet only appears in AgentBook once its human registers it through
# World App: `npx @worldcoin/agentkit-cli register <agent-wallet>`.
WELL_WORLD_ENABLED=1
WELL_WORLD_MOCK=0
WELL_WORLD_CHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
WELL_AGENTBOOK_ADDRESS=0xA23aB2712eA7BBa896930544C7d6636a96b944dA
