# Postgres (Prisma)
DATABASE_URL="postgresql://user@localhost:5432/votive"

# Chain (read surfaces)
NEXT_PUBLIC_WELL_CHAIN_ID=84532
NEXT_PUBLIC_WELL_RPC_URL=https://base-sepolia-rpc.publicnode.com
NEXT_PUBLIC_WELL_FACTORY=0x...
NEXT_PUBLIC_WELL_REGISTRY=0x...
NEXT_PUBLIC_WELL_POSITION_REGISTRY=0x...
NEXT_PUBLIC_WELL_TOKENS=0x...:USDC:6

# Web push (VAPID) — optional
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The origin this deployment answers on, baked into every skill file served at
# /skills/* so an agent knows where to POST back.
#
# Leave it UNSET in normal operation: the origin is derived per-request from
# x-forwarded-proto / x-forwarded-host / host, which is correct by construction on
# localhost, a preview build and production alike. Set it only when a proxy
# rewrites Host to something an agent cannot reach back on — then this wins.
#
#   WELL_BASE_URL=https://votive.example
WELL_BASE_URL=

# ---- World: AgentBook (real lookups, not mock) -----------------------------
# An agent wallet only appears in AgentBook once its human registers it through
# World App: `npx @worldcoin/agentkit-cli register <agent-wallet>`.
WELL_WORLD_ENABLED=1
WELL_WORLD_MOCK=0
WELL_WORLD_CHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
WELL_AGENTBOOK_ADDRESS=0xA23aB2712eA7BBa896930544C7d6636a96b944dA
